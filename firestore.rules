rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Account profile lives at users/{uid}
    // Console path: Firestore → Data → users → <Firebase Auth UID>
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /walletTransactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Pickup and return events for the signed-in account.
      // Document id: {reservationId}_pickup or {reservationId}_return
      // kind, reservationId, toolName, title, detail, role, occursAt,
      // address, loanStatus, activityCleared, createdAt, updatedAt
      match /scheduleEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
